VITE_API_BASE_URL=http://localhost:8000/api/v1

APP_NAME=WebIntel AI
APP_ENV=local
APP_DEBUG=true
API_V1_PREFIX=/api/v1

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=webintel
POSTGRES_USER=webintel
POSTGRES_PASSWORD=webintel_dev_password

DATABASE_URL=postgresql+asyncpg://webintel:webintel_dev_password@localhost:5432/webintel
DATABASE_ECHO=false

REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RAW_PAGES_TOPIC=raw-pages
KAFKA_EXTRACTED_DATA_TOPIC=extracted-data
KAFKA_EXTRACTION_GROUP_ID=webintel-extraction-workers
KAFKA_CLIENT_ID=webintel-backend
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
ELASTICSEARCH_URL=http://localhost:9200

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TIMEZONE=UTC
REDBEAT_REDIS_URL=redis://localhost:6379/3

CRAWLER_USER_AGENT=WebIntelAI/0.1 (+https://local.webintel.ai)
CRAWLER_REQUEST_TIMEOUT_SECONDS=30
CRAWLER_MAX_CONCURRENCY=8
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_NAVIGATION_TIMEOUT_MS=30000
PLAYWRIGHT_BLOCK_RESOURCE_TYPES=["image","media","font"]

SPACY_MODEL=en_core_web_sm
HF_QA_MODEL=distilbert-base-cased-distilled-squad
EXTRACTION_CONFIDENCE_THRESHOLD=0.82
EXTRACTION_MAX_TEXT_CHARS=24000
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-4.1-mini

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
